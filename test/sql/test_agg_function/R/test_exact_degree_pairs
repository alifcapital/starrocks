-- !result
WITH exact AS (
SELECT cid,0 side,stats_degree_state(k0) s FROM degree_pairs GROUP BY cid
UNION ALL
SELECT cid,1 side,stats_degree_state(k1) s FROM degree_pairs GROUP BY cid)
SELECT COUNT(*) FROM exact e FULL JOIN degree_pair_marginals p ON e.cid=p.cid AND e.side=p.side
WHERE e.cid IS NULL OR p.cid IS NULL OR stats_degree_info(e.s)!=stats_degree_info(p.s)
OR get_json_double(stats_degree_pair(e.s,p.s),'$[0]')!=get_json_double(stats_degree_info(e.s),'$.moments[1]');
-- result:
0
-- !result
WITH exact_pairs AS (SELECT cid,k0,k1 FROM degree_pairs GROUP BY cid,k0,k1),
l AS (SELECT cid,k0,COUNT(*) d FROM degree_pairs GROUP BY cid,k0),
r AS (SELECT cid,k1,COUNT(*) d FROM degree_pairs GROUP BY cid,k1),
expected AS (SELECT j.cid,COUNT(*) n,SUM(CAST(l.d AS DOUBLE)*r.d) m1,
SUM(POW(CAST(l.d AS DOUBLE)*r.d,2)) m2,SUM(POW(CAST(l.d AS DOUBLE)*r.d,3)) m3
FROM exact_pairs j JOIN l ON j.cid=l.cid AND j.k0=l.k0 JOIN r ON j.cid=r.cid AND j.k1=r.k1 GROUP BY j.cid),
values_ AS (SELECT j.cid,stats_degree_intra(j.s,l.s,r.s,j.s0,j.s1) v
FROM degree_pair_blocks j JOIN degree_pair_marginals l ON j.cid=l.cid AND l.side=0
JOIN degree_pair_marginals r ON j.cid=r.cid AND r.side=1),
actual AS (SELECT cid,SUM(get_json_double(v,'$[0]')) n,SUM(get_json_double(v,'$[1]')) m1,
SUM(get_json_double(v,'$[2]')) m2,SUM(get_json_double(v,'$[3]')) m3 FROM values_ GROUP BY cid)
SELECT COUNT(*) FROM expected e FULL JOIN actual a ON e.cid=a.cid WHERE e.cid IS NULL OR a.cid IS NULL
OR e.n!=a.n OR ABS(e.m1-a.m1)/GREATEST(1,e.m1)>1e-12
OR ABS(e.m2-a.m2)/GREATEST(1,e.m2)>1e-12 OR ABS(e.m3-a.m3)/GREATEST(1,e.m3)>1e-12;
