-- !result
INSERT INTO degree_pair_blocks
SELECT cid,COALESCE(bit_shift_right(k0,8),0),COALESCE(bit_shift_right(k1,7),0),
stats_degree_state(bitor(bitor(bit_shift_left(COALESCE(bitand(k0,255),0),7),COALESCE(bitand(k1,127),0)),
IF(k0 IS NULL,32768,0)+IF(k1 IS NULL,65536,0))),COUNT(*),COUNT(k0),COUNT(k1)
FROM degree_pairs GROUP BY cid,COALESCE(bit_shift_right(k0,8),0),COALESCE(bit_shift_right(k1,7),0);
