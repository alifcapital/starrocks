CREATE TABLE degree_pair_blocks(cid INT,s0 BIGINT,s1 BIGINT,s VARBINARY(1048576),n BIGINT,nn0 BIGINT,nn1 BIGINT)
DUPLICATE KEY(cid,s0,s1) DISTRIBUTED BY HASH(s0,s1) BUCKETS 3
PROPERTIES('replication_num'='1');
