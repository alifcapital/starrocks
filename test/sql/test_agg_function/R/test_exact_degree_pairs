CREATE TABLE degree_pair_marginals(cid INT,side INT,s VARBINARY(1048576))
DUPLICATE KEY(cid,side) DISTRIBUTED BY HASH(cid) BUCKETS 3
PROPERTIES('replication_num'='1');
-- result:
-- !result
INSERT INTO degree_pair_marginals
SELECT cid,0,stats_degree_merge(stats_degree_project(s,s0,0)) FROM degree_pair_blocks GROUP BY cid
UNION ALL
SELECT cid,1,stats_degree_merge(stats_degree_project(s,s1,1)) FROM degree_pair_blocks GROUP BY cid;
