-- name: test_in_or_to_union
CREATE TABLE `t_left` (`id` int NOT NULL, `v` bigint NULL, `w` int NULL, `d` date NULL, `dt` datetime NULL) ENGINE=OLAP DUPLICATE KEY(`id`) DISTRIBUTED BY HASH(`id`) BUCKETS 3 PROPERTIES ("replication_num" = "1");
CREATE TABLE `s_big` (`c` bigint NULL) ENGINE=OLAP DUPLICATE KEY(`c`) DISTRIBUTED BY HASH(`c`) BUCKETS 3 PROPERTIES ("replication_num" = "1");
CREATE TABLE `s_int` (`c` int NULL) ENGINE=OLAP DUPLICATE KEY(`c`) DISTRIBUTED BY HASH(`c`) BUCKETS 3 PROPERTIES ("replication_num" = "1");
CREATE TABLE `s_null` (`c` bigint NULL) ENGINE=OLAP DUPLICATE KEY(`c`) DISTRIBUTED BY HASH(`c`) BUCKETS 3 PROPERTIES ("replication_num" = "1");
CREATE TABLE `s_empty` (`c` bigint NULL) ENGINE=OLAP DUPLICATE KEY(`c`) DISTRIBUTED BY HASH(`c`) BUCKETS 3 PROPERTIES ("replication_num" = "1");
CREATE TABLE `s_date` (`c` date NULL) ENGINE=OLAP DUPLICATE KEY(`c`) DISTRIBUTED BY HASH(`c`) BUCKETS 3 PROPERTIES ("replication_num" = "1");
CREATE TABLE `s_datetime` (`c` datetime NULL) ENGINE=OLAP DUPLICATE KEY(`c`) DISTRIBUTED BY HASH(`c`) BUCKETS 3 PROPERTIES ("replication_num" = "1");
