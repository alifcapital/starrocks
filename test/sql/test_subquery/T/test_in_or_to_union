insert into s_dec4 values (1.2290), (1.5000);
-- The rewrite is on (default): OR of IN subqueries in WHERE and HAVING.
set enable_rewrite_in_or_to_union = true;
select id from t_left where v in (select c from s_big) or v in (select c from s_int) order by id;
select id from t_left where v in (select c from s_big) or v in (select c from s_null) order by id;
select id from t_left where v in (select c from s_empty) or v in (select c from s_big) order by id;
select id from t_left where v in (select c from s_empty) or v in (select c from s_empty) order by id;
select id from t_left where v in (select c from s_null) or v in (select c from s_null) order by id;
select id from t_left where v in (select c from s_big) or v in (select c from s_int) or v in (select c from s_null) order by id;
select id from t_left where w in (select c from s_int) or w in (select c from s_big) order by id;
select id from t_left where v + 1 in (select c from s_big) or v + 1 in (select c from s_int) order by id;
select id from t_left where id > 2 and (v in (select c from s_big) or v in (select c from s_int)) order by id;
select count(*) from t_left where v in (select c from s_big) or v in (select c from s_int);
select v, count(*) from t_left group by v having v in (select c from s_big) or v in (select c from s_int) order by v;
select id from t_left where dt in (select c from s_date) or dt in (select c from s_datetime) order by id;
select id from t_left where d in (select c from s_date) or d in (select c from s_datetime) order by id;
-- Subqueries of different types are not merged: the comparison type of x depends on the type of the subquery.
select id from t_str where s in (select c from s_date) or s in (select c from s_datetime) order by id;
select id from t_str where s in (select c from s_dec2) or s in (select c from s_dec4) order by id;
select id from t_num where i in (select c from s_date) or i in (select c from s_datetime) order by id;
select id from t_str where s in (select c from s_date) or s in (select c from s_date) order by id;
select id from t_str where s in (select c from s_dec4) or s in (select c from s_dec4) order by id;
-- Three-valued logic stays as it is outside a top-level conjunct.
select id from t_left where not (v in (select c from s_big) or v in (select c from s_int)) order by id;
select id from t_left where not (v in (select c from s_big) or v in (select c from s_null)) order by id;
select id from t_left where (v in (select c from s_big) or v in (select c from s_null)) is null order by id;
select id, (v in (select c from s_big) or v in (select c from s_null)) as r from t_left order by id;
-- The same queries with the rewrite off give the same rows.
set enable_rewrite_in_or_to_union = false;
select id from t_left where v in (select c from s_big) or v in (select c from s_int) order by id;
select id from t_left where v in (select c from s_big) or v in (select c from s_null) order by id;
select id from t_left where v in (select c from s_empty) or v in (select c from s_big) order by id;
select id from t_left where v in (select c from s_empty) or v in (select c from s_empty) order by id;
select id from t_left where v in (select c from s_null) or v in (select c from s_null) order by id;
select id from t_left where v in (select c from s_big) or v in (select c from s_int) or v in (select c from s_null) order by id;
select id from t_left where w in (select c from s_int) or w in (select c from s_big) order by id;
select id from t_left where v + 1 in (select c from s_big) or v + 1 in (select c from s_int) order by id;
select id from t_left where id > 2 and (v in (select c from s_big) or v in (select c from s_int)) order by id;
select count(*) from t_left where v in (select c from s_big) or v in (select c from s_int);
select v, count(*) from t_left group by v having v in (select c from s_big) or v in (select c from s_int) order by v;
select id from t_left where dt in (select c from s_date) or dt in (select c from s_datetime) order by id;
select id from t_left where d in (select c from s_date) or d in (select c from s_datetime) order by id;
select id from t_str where s in (select c from s_date) or s in (select c from s_datetime) order by id;
select id from t_str where s in (select c from s_dec2) or s in (select c from s_dec4) order by id;
select id from t_num where i in (select c from s_date) or i in (select c from s_datetime) order by id;
select id from t_str where s in (select c from s_date) or s in (select c from s_date) order by id;
select id from t_str where s in (select c from s_dec4) or s in (select c from s_dec4) order by id;
set enable_rewrite_in_or_to_union = true;
