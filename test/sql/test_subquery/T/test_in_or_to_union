CREATE TABLE `t_str` (`id` int NOT NULL, `s` varchar(30) NULL) ENGINE=OLAP DUPLICATE KEY(`id`) DISTRIBUTED BY HASH(`id`) BUCKETS 3 PROPERTIES ("replication_num" = "1");
CREATE TABLE `t_num` (`id` int NOT NULL, `i` int NULL) ENGINE=OLAP DUPLICATE KEY(`id`) DISTRIBUTED BY HASH(`id`) BUCKETS 3 PROPERTIES ("replication_num" = "1");
CREATE TABLE `s_dec2` (`c` decimal(10,2) NULL) ENGINE=OLAP DUPLICATE KEY(`c`) DISTRIBUTED BY HASH(`c`) BUCKETS 3 PROPERTIES ("replication_num" = "1");
CREATE TABLE `s_dec4` (`c` decimal(12,4) NULL) ENGINE=OLAP DUPLICATE KEY(`c`) DISTRIBUTED BY HASH(`c`) BUCKETS 3 PROPERTIES ("replication_num" = "1");
