-- name: selected conditional expression evaluation

CREATE DATABASE selected_eval_${uuid0};

USE selected_eval_${uuid0};

SET enable_conditional_two_phase_eval=true;

SET jit_level=0;

CREATE TABLE t(id INT, p VARCHAR(8192), doc VARCHAR(8192), pat VARCHAR(100))
DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 1 PROPERTIES("replication_num"="1");

INSERT INTO t VALUES (0,'abc0','{"n":0}','abc([0-9]+)'),
(1,'abc1','{"n":1}','abc([0-9]+)'), (2,NULL,'{"n":2}','abc([0-9]+)'),
(3,'abc3',NULL,'abc([0-9]+)'), (4,'abc4','{"n":4}','abc([0-9]+)'),
(5,'abc5','invalid','abc([0-9]+)');

SELECT id, CASE WHEN id%2=0 THEN regexp_extract(p,pat,1) ELSE 'skip' END FROM t ORDER BY id;

SELECT id, CASE WHEN id<4 THEN CAST(parse_json(doc)->'$.n' AS BIGINT) ELSE -1 END FROM t ORDER BY id;

SELECT id, CASE WHEN id%2=0 THEN regexp_extract(lower(p),pat,1) ELSE 'skip' END FROM t ORDER BY id;

SELECT id, CASE WHEN id%2=0 THEN regexp_extract(p,lower(pat),1) ELSE 'skip' END FROM t ORDER BY id;

SELECT id, CASE WHEN id<2 THEN 'first' WHEN id<5 THEN regexp_extract(p,pat,1) ELSE 'last' END FROM t ORDER BY id;

SELECT id, COALESCE(IF(id%2=0,NULL,'first'),regexp_extract(p,pat,1),'last') FROM t ORDER BY id;

SELECT id, IFNULL(IF(id%2=0,NULL,'first'),CAST(parse_json(doc)->'$.n' AS CHAR)) FROM t ORDER BY id;

SELECT id, CASE WHEN id%2=0 THEN CAST(regexp_extract(p,pat,1) AS BIGINT) ELSE -1 END FROM t ORDER BY id;

SELECT id, CASE WHEN id<5 THEN CASE WHEN id%2=0 THEN regexp_extract(p,pat,1) ELSE 'inner' END ELSE 'outer' END FROM t ORDER BY id;

SELECT id, length(CASE WHEN id%2=0 THEN regexp_extract(p,pat,1) ELSE repeat('x',4096) END) FROM t ORDER BY id;

DROP DATABASE selected_eval_${uuid0};
