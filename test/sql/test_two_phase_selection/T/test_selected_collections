 CASE WHEN id%7=0 THEN NULL ELSE [id%5,cast(NULL AS BIGINT),id%11,id%5] END a,
 CASE WHEN id%9=0 THEN NULL ELSE [id%3,id%2,id%7,id%3] END b,
 CASE WHEN id%11=0 THEN NULL ELSE map('a',cast(id AS CHAR),'b',payload_small) END m
