-- name: selected collections and complex casts

CREATE DATABASE selected_collections_${uuid0};

USE selected_collections_${uuid0};

SET enable_conditional_two_phase_eval=true;

SET jit_level=0;

CREATE TABLE inputs(id INT, payload_small VARCHAR(4096), payload_large VARCHAR(8192)) DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 1 PROPERTIES("replication_num"="1");

INSERT INTO inputs VALUES (0,'{"body":{"txn":{"originator":{"number":"0"}}}}','{"number":0,"padding":"longer number"}'),(1,'{"body":{"txn":{"originator":{"number":"1"}}}}','{"number":1,"padding":"longer number"}'),(2,'{"body":{"txn":{"originator":{"number":"2"}}}}','{"number":2,"padding":"longer number"}'),(3,'{"body":{"txn":{"originator":{"number":"3"}}}}','{"number":3,"padding":"longer number"}'),(4,'{"body":{"txn":{"originator":{"number":"4"}}}}','{"number":4,"padding":"longer number"}'),(5,'{"body":{"txn":{"originator":{"number":"5"}}}}','{"number":5,"padding":"longer number"}'),(6,'{"body":{"txn":{"originator":{"number":"6"}}}}','{"number":6,"padding":"longer number"}'),(7,'{"body":{"txn":{"originator":{"number":"7"}}}}','{"number":7,"padding":"longer number"}'),(8,'{"body":{"txn":{"originator":{"number":"8"}}}}','{"number":8,"padding":"longer number"}'),(9,'{"body":{"txn":{"originator":{"number":"9"}}}}','{"number":9,"padding":"longer number"}');

