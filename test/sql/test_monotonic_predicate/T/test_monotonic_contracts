-- name: test_monotonic_contracts
create database db_${uuid0};
use db_${uuid0};
set time_zone = '+00:00';
set cbo_eq_base_type = 'varchar';
set enable_string_date_join_pruning = false;
create table event_dates (booking_id int, datadate varchar(20)) duplicate key(booking_id) distributed by hash(booking_id) buckets 1 properties ("replication_num"="1");
create table fact_by_month (booking_id int, datamonth int) duplicate key(booking_id) distributed by hash(booking_id) buckets 1 properties ("replication_num"="1");
insert into event_dates values (1,'20120706'),(2,'2012072');
insert into fact_by_month values (1,201207),(2,202012);
select f.booking_id, f.datamonth from fact_by_month f join event_dates e on f.booking_id=e.booking_id and f.datamonth=date_format(cast(e.datadate as date),'%Y%m') where e.datadate between '20120701' and '20120731' order by f.booking_id;
set enable_monotonic_predicate_move_around = false;
select f.booking_id, f.datamonth from fact_by_month f join event_dates e on f.booking_id=e.booking_id and f.datamonth=date_format(cast(e.datadate as date),'%Y%m') where e.datadate between '20120701' and '20120731' order by f.booking_id;
set enable_monotonic_predicate_move_around = true;
delete from event_dates where booking_id=2;
insert into event_dates values (2,'20201207');
set enable_string_date_join_pruning = true;
select f.booking_id, f.datamonth from fact_by_month f join event_dates e on f.booking_id=e.booking_id and f.datamonth=date_format(cast(e.datadate as date),'%Y%m') where e.datadate between '20120701' and '20120731' order by f.booking_id;
set cbo_eq_base_type = 'decimal';
select f.booking_id, f.datamonth from fact_by_month f join event_dates e on f.booking_id=e.booking_id and f.datamonth=date_format(cast(e.datadate as date),'%Y%m') where e.datadate between '20120701' and '20120731' order by f.booking_id;
set enable_string_date_join_pruning = false;
create table epoch_values (id int, ep bigint) duplicate key(id) distributed by hash(id) buckets 1 properties ("replication_num"="1");
insert into epoch_values values (1,-1),(2,0),(3,1000),(4,253402243199999),(5,NULL);
set enable_monotonic_predicate_rewrite = true;
select id, (from_unixtime(ep)='2024-03-05 10:30:00') is null from epoch_values order by id;
select id from epoch_values where from_unixtime_ms(ep)='1970-01-01 00:00:00' order by id;
select id from epoch_values where from_unixtime_ms(ep)>='2024-03-05 10:30:00' order by id;
set enable_monotonic_predicate_rewrite = false;
select id, (from_unixtime(ep)='2024-03-05 10:30:00') is null from epoch_values order by id;
select id from epoch_values where from_unixtime_ms(ep)='1970-01-01 00:00:00' order by id;
select id from epoch_values where from_unixtime_ms(ep)>='2024-03-05 10:30:00' order by id;
set enable_monotonic_predicate_rewrite = true;
create table time_values (id int, ts datetime) duplicate key(id) distributed by hash(id) buckets 1 properties ("replication_num"="1");
insert into time_values values (1,'9999-12-31 07:59:59.500000'),(2,'9999-12-31 08:00:00'),(3,'2025-01-01 00:00:00');
set enable_monotonic_predicate_rewrite = true;
select id from time_values where unix_timestamp(ts)>=1700000000 order by id;
select id, (days_add(ts,3)>='2024-01-01') is null from time_values order by id;
set enable_monotonic_predicate_rewrite = false;
select id from time_values where unix_timestamp(ts)>=1700000000 order by id;
select id, (days_add(ts,3)>='2024-01-01') is null from time_values order by id;
set enable_monotonic_predicate_rewrite = true;
create table day_keys (id int, ds varchar(10)) duplicate key(id) distributed by hash(id) buckets 1 properties ("replication_num"="1");
insert into day_keys values (1,'9999-12-31'),(2,'1970-01-01'),(3,'2025-01-01');
set enable_monotonic_predicate_move_around = true;
select f.id from day_keys f join time_values e on f.id=e.id and f.ds=from_unixtime(unix_timestamp(e.ts),'%Y-%m-%d') where e.ts between '2024-01-01' and '9999-12-31 23:59:59' order by f.id;
set enable_monotonic_predicate_move_around = false;
select f.id from day_keys f join time_values e on f.id=e.id and f.ds=from_unixtime(unix_timestamp(e.ts),'%Y-%m-%d') where e.ts between '2024-01-01' and '9999-12-31 23:59:59' order by f.id;
set enable_monotonic_predicate_move_around = true;
set time_zone = default;
set cbo_eq_base_type = default;
drop database db_${uuid0};
