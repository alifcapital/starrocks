-- name: test_invert_format_functions
create database db_${uuid0};
use db_${uuid0};

create table rw_month (id bigint not null, d date not null, v bigint null)
duplicate key(id, d)
partition by range(d) (
 partition p202401 values [('2024-01-01'), ('2024-02-01')),
 partition p202402 values [('2024-02-01'), ('2024-03-01')),
 partition p202403 values [('2024-03-01'), ('2024-04-01')),
 partition p202404 values [('2024-04-01'), ('2024-05-01')),
 partition pmax    values [('9999-12-01'), (MAXVALUE)))
distributed by hash(id) buckets 3
properties ("replication_num" = "1");
insert into rw_month values (1,'2024-01-15',1),(2,'2024-01-30',1),(3,'2024-01-31',1),(4,'2024-02-29',1),(5,'2024-03-01',1),(6,'2024-03-15',1),(7,'2024-03-31',1),(8,'2024-04-01',1),(9,'9999-12-31',1);

create table rw_ts (id bigint not null, ts datetime not null)
duplicate key(id, ts)
partition by range(ts) (
 partition p202402 values [('2024-02-01 00:00:00'), ('2024-03-01 00:00:00')),
 partition p202403 values [('2024-03-01 00:00:00'), ('2024-04-01 00:00:00')),
 partition p202404 values [('2024-04-01 00:00:00'), ('2024-05-01 00:00:00')))
distributed by hash(id) buckets 3
properties ("replication_num" = "1");
insert into rw_ts values (1,'2024-02-29 23:59:59'),(2,'2024-03-01 00:00:00'),(3,'2024-03-01 10:30:00'),(4,'2024-03-31 23:59:59'),(5,'2024-04-01 00:00:00');

-- date_format month period
set enable_monotonic_predicate_rewrite = true;
select id from rw_month where date_format(d, '%Y%m') = '202403' order by id;
set enable_monotonic_predicate_rewrite = false;
select id from rw_month where date_format(d, '%Y%m') = '202403' order by id;
set enable_monotonic_predicate_rewrite = true;

-- date_format day point: NE inverts only in the point shape
set enable_monotonic_predicate_rewrite = true;
select id from rw_month where date_format(d, '%Y%m%d') != '20240315' order by id;
set enable_monotonic_predicate_rewrite = false;
select id from rw_month where date_format(d, '%Y%m%d') != '20240315' order by id;
set enable_monotonic_predicate_rewrite = true;

-- year period
set enable_monotonic_predicate_rewrite = true;
select id from rw_month where year(d) = 2024 order by id;
set enable_monotonic_predicate_rewrite = false;
select id from rw_month where year(d) = 2024 order by id;
set enable_monotonic_predicate_rewrite = true;

-- datediff with the column in either argument
set enable_monotonic_predicate_rewrite = true;
select id from rw_month where datediff(d, '2024-01-01') <= 45 order by id;
select id from rw_month where datediff('2024-03-31', d) <= 10 order by id;
set enable_monotonic_predicate_rewrite = false;
select id from rw_month where datediff(d, '2024-01-01') <= 45 order by id;
select id from rw_month where datediff('2024-03-31', d) <= 10 order by id;
set enable_monotonic_predicate_rewrite = true;

-- to_date over a datetime column is a day period
set enable_monotonic_predicate_rewrite = true;
select id from rw_ts where to_date(ts) = '2024-03-01' order by id;
set enable_monotonic_predicate_rewrite = false;
select id from rw_ts where to_date(ts) = '2024-03-01' order by id;
set enable_monotonic_predicate_rewrite = true;

-- second-resolution date_format keeps order and inverts exactly
set enable_monotonic_predicate_rewrite = true;
select id from rw_ts where date_format(ts, '%Y-%m-%d %H:%i:%s') >= '2024-03-01 10:30:00' order by id;
select id from rw_ts where date_format(ts, '%Y%m') <= '202403' order by id;
set enable_monotonic_predicate_rewrite = false;
select id from rw_ts where date_format(ts, '%Y-%m-%d %H:%i:%s') >= '2024-03-01 10:30:00' order by id;
select id from rw_ts where date_format(ts, '%Y%m') <= '202403' order by id;
set enable_monotonic_predicate_rewrite = true;

-- the inverted month period prunes on the bare column
function: assert_explain_contains("select id from rw_month where date_format(d, '%Y%m') = '202403'", 'partitions=1/5')

drop database db_${uuid0};
