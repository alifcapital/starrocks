-- name: test_invert_period_shift
create database db_${uuid0};
use db_${uuid0};

create table rw_month (id bigint not null, d date not null, v bigint null)
duplicate key(id, d)
partition by range(d) (
 partition p202401 values [('2024-01-01'), ('2024-02-01')),
 partition p202402 values [('2024-02-01'), ('2024-03-01')),
 partition p202403 values [('2024-03-01'), ('2024-04-01')),
 partition p202404 values [('2024-04-01'), ('2024-05-01')),
 partition pmax    values [('9999-12-01'), (MAXVALUE)))
distributed by hash(id) buckets 3
properties ("replication_num" = "1");
insert into rw_month values (1,'2024-01-15',1),(2,'2024-01-30',1),(3,'2024-01-31',1),(4,'2024-02-29',1),(5,'2024-03-01',1),(6,'2024-03-15',1),(7,'2024-03-31',1),(8,'2024-04-01',1),(9,'9999-12-31',1);

create table rw_ts (id bigint not null, ts datetime not null)
duplicate key(id, ts)
partition by range(ts) (
 partition p202402 values [('2024-02-01 00:00:00'), ('2024-03-01 00:00:00')),
 partition p202403 values [('2024-03-01 00:00:00'), ('2024-04-01 00:00:00')),
 partition p202404 values [('2024-04-01 00:00:00'), ('2024-05-01 00:00:00')))
distributed by hash(id) buckets 3
properties ("replication_num" = "1");
insert into rw_ts values (1,'2024-02-29 23:59:59'),(2,'2024-03-01 00:00:00'),(3,'2024-03-01 10:30:00'),(4,'2024-03-31 23:59:59'),(5,'2024-04-01 00:00:00');

-- month shift clamps: 2024-01-30 and 2024-01-31 both map to 2024-02-29 and must be returned
set enable_monotonic_predicate_rewrite = true;
select id from rw_month where months_add(d, 1) <= '2024-02-29' order by id;
set enable_monotonic_predicate_rewrite = false;
select id from rw_month where months_add(d, 1) <= '2024-02-29' order by id;
set enable_monotonic_predicate_rewrite = true;

-- shift overflow guard: days_add('9999-12-31', 3) is NULL, id 9 must not be returned
set enable_monotonic_predicate_rewrite = true;
select id from rw_month where days_add(d, 3) >= '2024-01-30' order by id;
set enable_monotonic_predicate_rewrite = false;
select id from rw_month where days_add(d, 3) >= '2024-01-30' order by id;
set enable_monotonic_predicate_rewrite = true;

-- aligned period equality
set enable_monotonic_predicate_rewrite = true;
select id from rw_month where date_trunc('month', d) = '2024-03-01' order by id;
set enable_monotonic_predicate_rewrite = false;
select id from rw_month where date_trunc('month', d) = '2024-03-01' order by id;
set enable_monotonic_predicate_rewrite = true;

-- misaligned period equality is empty, never FALSE-with-NULL-loss
set enable_monotonic_predicate_rewrite = true;
select id from rw_month where date_trunc('month', d) = '2024-03-15' order by id;
set enable_monotonic_predicate_rewrite = false;
select id from rw_month where date_trunc('month', d) = '2024-03-15' order by id;
set enable_monotonic_predicate_rewrite = true;

-- the rewrite must stay an equivalence under NOT
set enable_monotonic_predicate_rewrite = true;
select id from rw_month where not (date_trunc('month', d) >= '2024-03-01') order by id;
set enable_monotonic_predicate_rewrite = false;
select id from rw_month where not (date_trunc('month', d) >= '2024-03-01') order by id;
set enable_monotonic_predicate_rewrite = true;

-- day period at the DATE maximum: no next-period boundary exists, the row must still match
set enable_monotonic_predicate_rewrite = true;
select id from rw_month where date_trunc('day', d) = '9999-12-31' order by id;
set enable_monotonic_predicate_rewrite = false;
select id from rw_month where date_trunc('day', d) = '9999-12-31' order by id;
set enable_monotonic_predicate_rewrite = true;

-- a datetime day period includes the last second of the day
set enable_monotonic_predicate_rewrite = true;
select id from rw_ts where date_trunc('day', ts) = '2024-03-31' order by id;
select id from rw_ts where date_trunc('day', ts) = '2024-03-01' order by id;
set enable_monotonic_predicate_rewrite = false;
select id from rw_ts where date_trunc('day', ts) = '2024-03-31' order by id;
select id from rw_ts where date_trunc('day', ts) = '2024-03-01' order by id;
set enable_monotonic_predicate_rewrite = true;

-- the inverted predicate lands on the bare partition column and prunes
function: assert_explain_contains("select id from rw_month where date_trunc('month', d) = '2024-03-01'", 'partitions=1/5')

drop database db_${uuid0};
