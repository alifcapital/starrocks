-- name: test_join_derive_digit_only_int_key
create database db_${uuid0};
use db_${uuid0};

create table fact_by_month (booking_id bigint not null, datamonth int not null, v bigint null)
duplicate key(booking_id, datamonth)
partition by range(datamonth) (
 partition p202601 values [('202601'), ('202602')),
 partition p202602 values [('202602'), ('202603')),
 partition p202605 values [('202605'), ('202606')),
 partition p202606 values [('202606'), ('202607')),
 partition p202607 values [('202607'), ('202608')),
 partition p202608 values [('202608'), ('202609')))
distributed by hash(booking_id) buckets 3
properties ("replication_num" = "1");
insert into fact_by_month values (10,202601,1),(11,202605,1),(12,202606,1),(13,202606,2),(14,202607,1),(15,202608,1),(12,202608,9);

create table ev_date (booking_id bigint not null, datadate date not null)
duplicate key(booking_id, datadate)
distributed by hash(booking_id) buckets 3
properties ("replication_num" = "1");
insert into ev_date values (12,'2026-06-30'),(13,'2026-07-01'),(14,'2026-07-02'),(11,'2026-05-10'),(15,'2026-08-20');

-- VARCHAR cannot be a RANGE partition key; a varchar month key partitions by LIST
create table fact_by_month_v (booking_id bigint not null, datamonth varchar(6) not null, v bigint null)
duplicate key(booking_id, datamonth)
partition by list(datamonth) (
 partition p202601 values in ('202601'),
 partition p202602 values in ('202602'),
 partition p202605 values in ('202605'),
 partition p202606 values in ('202606'),
 partition p202607 values in ('202607'),
 partition p202608 values in ('202608'))
distributed by hash(booking_id) buckets 3
properties ("replication_num" = "1");
insert into fact_by_month_v values (10,'202601',1),(11,'202605',1),(12,'202606',1),(13,'202606',2),(14,'202607',1),(15,'202608',1),(12,'202608',9);

-- an int month key compared to a digit-only date rendering; under VARCHAR both sides
-- compare as strings, the derivation lands on cast(datamonth as varchar) and the
-- cast-predicate further-prune reads the partitions
set cbo_eq_base_type = 'varchar';
set enable_monotonic_predicate_move_around = true;
select f.booking_id, f.datamonth from fact_by_month f join ev_date e on f.booking_id = e.booking_id and f.datamonth = date_format(e.datadate, '%Y%m') where e.datadate between '2026-06-30' and '2026-07-02' order by f.booking_id, f.datamonth;
set enable_monotonic_predicate_move_around = false;
select f.booking_id, f.datamonth from fact_by_month f join ev_date e on f.booking_id = e.booking_id and f.datamonth = date_format(e.datadate, '%Y%m') where e.datadate between '2026-06-30' and '2026-07-02' order by f.booking_id, f.datamonth;
set enable_monotonic_predicate_move_around = true;

-- a varchar month key needs no cast at all: the derived range lands on the bare column
set enable_monotonic_predicate_move_around = true;
select f.booking_id, f.datamonth from fact_by_month_v f join ev_date e on f.booking_id = e.booking_id and f.datamonth = date_format(e.datadate, '%Y%m') where e.datadate between '2026-06-30' and '2026-07-02' order by f.booking_id, f.datamonth;
set enable_monotonic_predicate_move_around = false;
select f.booking_id, f.datamonth from fact_by_month_v f join ev_date e on f.booking_id = e.booking_id and f.datamonth = date_format(e.datadate, '%Y%m') where e.datadate between '2026-06-30' and '2026-07-02' order by f.booking_id, f.datamonth;
set enable_monotonic_predicate_move_around = true;

function: assert_explain_contains("select f.booking_id from fact_by_month_v f join ev_date e on f.booking_id = e.booking_id and f.datamonth = date_format(e.datadate, '%Y%m') where e.datadate between '2026-06-30' and '2026-07-02'", 'partitions=2/6')

drop database db_${uuid0};

-- name: test_join_derive_decimal_reduction
create database db_${uuid0};
use db_${uuid0};

create table fact_by_month (booking_id bigint not null, datamonth int not null, v bigint null)
duplicate key(booking_id, datamonth)
partition by range(datamonth) (
 partition p202601 values [('202601'), ('202602')),
 partition p202602 values [('202602'), ('202603')),
 partition p202605 values [('202605'), ('202606')),
 partition p202606 values [('202606'), ('202607')),
 partition p202607 values [('202607'), ('202608')),
 partition p202608 values [('202608'), ('202609')))
distributed by hash(booking_id) buckets 3
properties ("replication_num" = "1");
insert into fact_by_month values (10,202601,1),(11,202605,1),(12,202606,1),(13,202606,2),(14,202607,1),(15,202608,1),(12,202608,9);

create table ev_date (booking_id bigint not null, datadate date not null)
duplicate key(booking_id, datadate)
distributed by hash(booking_id) buckets 3
properties ("replication_num" = "1");
insert into ev_date values (12,'2026-06-30'),(13,'2026-07-01'),(14,'2026-07-02'),(11,'2026-05-10'),(15,'2026-08-20');

-- an integral decimal constant reduces onto the bare integer column
function: assert_explain_contains("select booking_id from fact_by_month where cast(datamonth as decimal(38,9)) >= 202606.000000000 and cast(datamonth as decimal(38,9)) <= 202607.000000000", 'partitions=2/6')

-- under DECIMAL both sides of the int-vs-varchar equality land on decimal128; the derived
-- decimal bounds must reduce onto the bare int column and prune through the native pruner
set cbo_eq_base_type = 'decimal';
set enable_monotonic_predicate_move_around = true;
select f.booking_id, f.datamonth from fact_by_month f join ev_date e on f.booking_id = e.booking_id and f.datamonth = date_format(e.datadate, '%Y%m') where e.datadate between '2026-06-30' and '2026-07-02' order by f.booking_id, f.datamonth;
set enable_monotonic_predicate_move_around = false;
select f.booking_id, f.datamonth from fact_by_month f join ev_date e on f.booking_id = e.booking_id and f.datamonth = date_format(e.datadate, '%Y%m') where e.datadate between '2026-06-30' and '2026-07-02' order by f.booking_id, f.datamonth;
set enable_monotonic_predicate_move_around = true;

function: assert_explain_contains("select f.booking_id from fact_by_month f join ev_date e on f.booking_id = e.booking_id and f.datamonth = date_format(e.datadate, '%Y%m') where e.datadate between '2026-06-30' and '2026-07-02'", 'partitions=2/6')

-- the production CTE shape: the month key of the middle join has no filter of its own,
-- pruning must land on the fact scan after inlining
set enable_monotonic_predicate_move_around = true;
with events as (select e.datadate, e.booking_id from ev_date e where e.datadate between '2026-06-30' and '2026-07-02'),
 fact_filter as (select f.booking_id, f.datamonth from fact_by_month f
   join (select distinct booking_id from events) e on f.booking_id = e.booking_id),
 facts as (select f.booking_id, f.datamonth from fact_filter f
   join events e on f.booking_id = e.booking_id and f.datamonth = date_format(cast(e.datadate as date), '%Y%m'))
 select * from facts order by booking_id, datamonth;
set enable_monotonic_predicate_move_around = false;
with events as (select e.datadate, e.booking_id from ev_date e where e.datadate between '2026-06-30' and '2026-07-02'),
 fact_filter as (select f.booking_id, f.datamonth from fact_by_month f
   join (select distinct booking_id from events) e on f.booking_id = e.booking_id),
 facts as (select f.booking_id, f.datamonth from fact_filter f
   join events e on f.booking_id = e.booking_id and f.datamonth = date_format(cast(e.datadate as date), '%Y%m'))
 select * from facts order by booking_id, datamonth;
set enable_monotonic_predicate_move_around = true;

drop database db_${uuid0};
