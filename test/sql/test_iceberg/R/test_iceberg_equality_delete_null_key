-- name: test_iceberg_equality_delete_null_key @sequential @native
-- Iceberg spec: a NULL value in an equality-delete column matches a row whose value is also NULL.
-- Without null-safe equality (the EQ -> EQ_FOR_NULL switch in IcebergEqualityDeleteRewriteRule) the
-- anti-join evaluates NULL = NULL -> UNKNOWN and the NULL-key rows resurrect. Fixture is a v2 table
-- (id,data) with 10 rows (incl. two NULL-id rows), one data file, and two equality-delete files (keys
-- {3,6} and the NULL key); with the fix exactly 6 rows stay visible -- the two NULL-id rows are deleted.
-- The fixture embeds absolute paths under /tmp/sr_eq_fixture/warehouse, so it is copied to that fixed
-- path (hence @sequential); FE and BE must share the local filesystem.
shell: rm -rf /tmp/sr_eq_fixture && mkdir -p /tmp/sr_eq_fixture/warehouse && cp -r ${root_path}/sql/test_iceberg/data/eq_delete_convert/* /tmp/sr_eq_fixture/warehouse/ > /dev/null || echo "exit 0" > /dev/null
-- result:
0

-- !result
create external catalog iceberg_eqnull_${uuid0} PROPERTIES ("type"="iceberg", "iceberg.catalog.type"="hadoop", "iceberg.catalog.warehouse"="file:///tmp/sr_eq_fixture/warehouse");
-- result:
-- !result
set new_planner_optimize_timeout = 30000;
-- result:
-- !result
select * from iceberg_eqnull_${uuid0}.eq_delete_db.eq_del_convert order by id;
-- result:
1	n1
2	n2
4	n4
5	n5
7	n7
8	n8
-- !result
drop catalog iceberg_eqnull_${uuid0};
-- result:
-- !result
shell: rm -rf /tmp/sr_eq_fixture > /dev/null || echo "exit 0" > /dev/null
-- result:
0

-- !result
